{
  "name": "tools",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "npm run dev:all",
    "start": "npm run start:all",
    "build": "npm run build:all",
    "preview": "npm run preview:all",
    "dev:all": "node src/runPackageBin.js concurrently --kill-others=false \"node src/server.js\" \"node src/runPackageBin.js vite\"",
    "start:all": "node src/server.js",
    "build:all": "node src/runPackageBin.js vite build",
    "preview:all": "node src/runPackageBin.js vite preview",
    "dev:pg-backup": "npm --prefix ./pg-backup run dev",
    "start:pg-backup": "npm --prefix ./pg-backup run start",
    "build:pg-backup": "npm --prefix ./pg-backup run build",
    "preview:pg-backup": "npm --prefix ./pg-backup run preview",
    "dev:mysql-tool": "npm --prefix ./mysql-tool run dev",
    "start:mysql-tool": "npm --prefix ./mysql-tool run start",
    "build:mysql-tool": "npm --prefix ./mysql-tool run build",
    "preview:mysql-tool": "npm --prefix ./mysql-tool run preview",
    "dev:mysql-pg-migrate": "npm --prefix ./mysql-pg-migrate run dev",
    "start:mysql-pg-migrate": "npm --prefix ./mysql-pg-migrate run start",
    "build:mysql-pg-migrate": "npm --prefix ./mysql-pg-migrate run build",
    "preview:mysql-pg-migrate": "npm --prefix ./mysql-pg-migrate run preview",
    "dev:semantic-qa": "npm --prefix ./semantic-qa run dev",
    "start:semantic-qa": "npm --prefix ./semantic-qa run start",
    "test:semantic-qa": "npm --prefix ./semantic-qa test",
    "build:semantic-qa": "npm --prefix ./semantic-qa run build",
    "preview:semantic-qa": "npm --prefix ./semantic-qa run preview",
    "dev:transcriber": "npm --prefix ./transcriber run dev",
    "start:transcriber": "npm --prefix ./transcriber run start",
    "setup:transcriber": "npm --prefix ./transcriber run setup:python",
    "test:transcriber": "npm --prefix ./transcriber test",
    "build:transcriber": "npm --prefix ./transcriber run build",
    "preview:transcriber": "npm --prefix ./transcriber run preview"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "elkjs": "^0.11.0",
    "express": "^5.2.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reactflow": "^11.11.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "eslint-plugin-react": "^7.37.5",
    "vite": "^7.3.1"
  }
}
