{
  "toolId": "self-voice-clone",
  "setupCommand": "npm run setup:self-voice-clone",
  "checks": [
    {
      "id": "python-environment",
      "type": "python-environment",
      "label": "Voice Clone Python environment",
      "path": ".venv/bin/python",
      "windowsPath": ".venv/Scripts/python.exe",
      "envVar": "SELF_VOICE_CLONE_PYTHON",
      "modules": ["fastapi", "uvicorn", "sqlalchemy", "pydantic", "numpy", "soundfile", "scipy", "faster_whisper", "speechbrain", "torchaudio", "voxcpm", "chatterbox"],
      "fix": "Run: npm run setup:self-voice-clone"
    },
    {
      "id": "ffmpeg",
      "type": "command",
      "label": "FFmpeg",
      "command": "ffmpeg",
      "args": ["-version"],
      "fix": "Install FFmpeg and make ffmpeg available on PATH."
    },
    {
      "id": "ffprobe",
      "type": "command",
      "label": "FFprobe",
      "command": "ffprobe",
      "args": ["-version"],
      "fix": "Install FFmpeg and make ffprobe available on PATH."
    }
  ]
}
