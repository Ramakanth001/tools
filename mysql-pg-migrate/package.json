{
  "name": "mysql-pg-migrate",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "node ../pg-backup/node_modules/concurrently/dist/bin/concurrently.js --kill-others=false \"node src/server.js\" \"node ../pg-backup/node_modules/vite/bin/vite.js --config vite.config.js\"",
    "start": "node src/server.js",
    "build": "node ../pg-backup/node_modules/vite/bin/vite.js build --config vite.config.js",
    "preview": "node ../pg-backup/node_modules/vite/bin/vite.js preview --config vite.config.js --port 5175"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.2.1",
    "mysql2": "^3.22.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "vite": "^7.3.1"
  }
}
